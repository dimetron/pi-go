TAVILY_API_KEY=tvly-dev-...
EXA_API_KEY=...
OLLAMA_API_KEY=...
# You.com MCP (the free profile in mcp-example.json needs no key; set this only
# to use the authenticated server at https://api.you.com/mcp)
YDC_API_KEY=...

# OpenTelemetry tracing — configure before running `pi acp-server`
# OTEL_SERVICE_NAME defaults to "pi-go" if unset
# OTEL_EXPORTER_OTLP_ENDPOINT defaults to "http://localhost:4318" if unset
# OTEL_TRACES_EXPORTER defaults to "otlp"; set to "none" to disable
# OTEL_TRACES_EXPORTER=otlp
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-collector.example.com:4317
# OTEL_SERVICE_NAME=pi-go