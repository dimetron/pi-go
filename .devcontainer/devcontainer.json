// pi-go development container.
//
// Mirrors what CI (.github/workflows/ci.yml) and the Makefile expect:
// Go (pinned to go.mod), golangci-lint v2, and the Node / Python+uv / Rust
// toolchains that the LSP fixtures under hack/test/lsp/ and internal/lsp
// shell out to.
{
  "name": "pi-go",
  // Debian base + features rather than a Go-tagged image: the Go feature
  // installs any released version straight from go.dev/dl, so the toolchain
  // can track go.mod exactly instead of whatever tag happens to be published.
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "configureZshAsDefaultShell": true,
      "upgradePackages": true,
      "username": "vscode"
    },
    // Keep in sync with the `go` directive in go.mod — CI resolves the
    // toolchain with `go-version-file: go.mod`.
    "ghcr.io/devcontainers/features/go:1": {
      "version": "1.26.5",
      // Installed pinned to v2.11 in post-create.sh to match the CI job;
      // the feature's own copy would be an unpinned "latest".
      "golangciLintVersion": "none"
    },
    // internal/lsp starts `typescript-language-server --stdio`.
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    },
    // internal/lsp starts `uvx ty server`; hack/test/lsp/python is a uv project.
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12",
      "installTools": false
    },
    "ghcr.io/va-h/devcontainers-features/uv:1": {
      "version": "latest"
    },
    // internal/lsp starts `rust-analyzer`; hack/test/lsp/rust is a cargo crate.
    "ghcr.io/devcontainers/features/rust:1": {
      "version": "latest",
      "profile": "minimal"
    },
    // internal/acp/client/gemini shells out to `docker`. Outside-of-docker
    // shares the host daemon socket — cheaper and faster than docker-in-docker,
    // at the cost of bind mounts being host paths.
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  // Ordered so the toolchains land on PATH the way internal/lsp/manager.go
  // probes for them ($GOPATH/bin, ~/.cargo/bin, ~/.local/bin).
  "containerEnv": {
    "GOPATH": "/home/vscode/go",
    // Matches `export GOEXPERIMENT := simd` in the Makefile and the
    // workflow-level env in ci.yml, so the build cache is not split.
    "GOEXPERIMENT": "simd",
    "PATH": "/home/vscode/go/bin:/home/vscode/.cargo/bin:/home/vscode/.local/bin:${containerEnv:PATH}"
  },
  // Provider keys are read straight from the host environment; absent ones
  // simply arrive empty. See CONTRIBUTING.md — at least one is needed to
  // exercise the agent.
  "remoteEnv": {
    "ANTHROPIC_API_KEY": "${localEnv:ANTHROPIC_API_KEY}",
    "OPENAI_API_KEY": "${localEnv:OPENAI_API_KEY}",
    "GEMINI_API_KEY": "${localEnv:GEMINI_API_KEY}",
    "GOOGLE_API_KEY": "${localEnv:GOOGLE_API_KEY}",
    "MISTRAL_API_KEY": "${localEnv:MISTRAL_API_KEY}"
  },
  // Named volumes: the Go module and build caches are the expensive things to
  // rebuild, and keeping them off the bind-mounted workspace also keeps them
  // off the (slow) host filesystem on macOS and Windows.
  "mounts": [
    "source=pi-go-gomodcache,target=/home/vscode/go/pkg/mod,type=volume",
    "source=pi-go-gobuildcache,target=/home/vscode/.cache/go-build,type=volume"
  ],
  // 6060 = `pi --pprof true` (net/http/pprof). Ollama, if used, runs on the
  // host: point the model base URL at http://host.docker.internal:11434.
  "forwardPorts": [
    6060
  ],
  "portsAttributes": {
    "6060": {
      "label": "pprof",
      "onAutoForward": "silent"
    }
  },
  "onCreateCommand": "bash .devcontainer/post-create.sh",
  // Cheap, and re-runs after a rebuild or a Git worktree switch.
  "postStartCommand": "go mod download",
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",
        "ms-vscode.makefile-tools",
        "github.vscode-github-actions",
        "redhat.vscode-yaml",
        "tamasfe.even-better-toml",
        "eamodio.gitlens",
        "streetsidesoftware.code-spell-checker"
      ],
      "settings": {
        "go.toolsManagement.autoUpdate": false,
        "go.lintTool": "golangci-lint",
        "go.lintFlags": [
          "--path-mode=abs",
          "--fast-only"
        ],
        "go.useLanguageServer": true,
        "gopls": {
          "formatting.local": "github.com/dimetron/pi-go"
        },
        "[go]": {
          "editor.formatOnSave": true,
          "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
          }
        },
        "terminal.integrated.defaultProfile.linux": "zsh"
      }
    }
  },
  "remoteUser": "vscode"
}
