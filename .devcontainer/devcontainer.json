// pi-go development container.
//
// Mirrors what CI (.github/workflows/ci.yml) and the Makefile expect:
// Go (pinned to go.mod), golangci-lint v2, and the Node / Python+uv / Rust
// toolchains that the LSP fixtures under hack/test/lsp/ and internal/lsp
// shell out to.
{
  "name": "pi-go",
  // Debian base + features rather than a Go-tagged image: the Go feature
  // installs any released version straight from go.dev/dl, so the toolchain
  // can track go.mod exactly instead of whatever tag happens to be published.
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "configureZshAsDefaultShell": true,
      "upgradePackages": true,
      "username": "vscode"
    },
    // Keep in sync with the `go` directive in go.mod — CI resolves the
    // toolchain with `go-version-file: go.mod`.
    "ghcr.io/devcontainers/features/go:1": {
      "version": "1.27.0",
      // ci.yml asks the action for "v2.13", which resolves to the newest
      // v2.13.x — so pin the patch here rather than v2.13.0, or the container
      // lints with an older ruleset than CI does. The feature has no way to
      // skip this install: "latest" and "" mean latest, and anything else is
      // used verbatim as the tag "v${value}" (so "none" 404s on "vnone").
      "golangciLintVersion": "2.13.2"
    },
    // Node, Python and Rust are deliberately absent. They exist only to run
    // real language servers for internal/lsp, and every test that needs one
    // skips when it is missing — the whole unit suite passes with just Go on
    // PATH. Together they added ~2 minutes to each rebuild (python compiles
    // CPython from source), so they moved to .devcontainer/install-deps.sh.
    //
    // internal/acp/client/gemini shells out to `docker`. In-docker rather than
    // outside-of-docker because `kind` below needs a daemon it can own: with a
    // shared host socket the cluster's API server lands on the *host's*
    // 127.0.0.1, so the kubeconfig kind writes is unreachable from in here.
    // Costs a privileged container and a cold image cache per rebuild; buys
    // bind mounts that use container paths, which is what the gemini client
    // assumes anyway.
    "ghcr.io/devcontainers/features/docker-in-docker:4": {
      "moby": false
    },
    "ghcr.io/devcontainers-extra/features/kind:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {
      "version": "latest",
      "helm": "latest",
      // kind is the cluster; minikube would just be a second, unused VM driver.
      "minikube": "none"
    },
    "ghcr.io/devcontainers/features/github-cli:1.1": {}
  },
  "containerEnv": {
    // Overrides the go feature's default of /go, so the module cache volume
    // below can live under the user's home. Do NOT set PATH here: every
    // toolchain feature contributes its own bin dir through its containerEnv,
    // and a PATH key in devcontainer.json wins over all of them while
    // ${containerEnv:PATH} still resolves against the *base image* — which
    // silently drops /usr/local/go/bin, node, python and cargo. Extra entries
    // go in remoteEnv, where ${containerEnv:PATH} sees the assembled value.
    "GOPATH": "/home/vscode/go",
    // Matches `export GOEXPERIMENT := simd` in the Makefile and the
    // workflow-level env in ci.yml, so the build cache is not split.
    "GOEXPERIMENT": "simd"
  },
  // Provider keys are read straight from the host environment; absent ones
  // simply arrive empty. See CONTRIBUTING.md — at least one is needed to
  // exercise the agent.
  "remoteEnv": {
    // $GOPATH/bin for `make install` and the tools post-create.sh installs.
    // ~/.local/bin and ~/.cargo/bin are where install-deps.sh puts uv and
    // rustup, so they are listed even though nothing occupies them until it
    // runs. GOROOT is already on ${containerEnv:PATH} via the go feature.
    //
    // This only reaches processes the dev container tooling starts, so
    // post-create.sh writes the same entries to /etc/profile.d — otherwise
    // `docker exec` and SSH sessions into a Codespace come up without them.
    "PATH": "/home/vscode/go/bin:/home/vscode/.local/bin:/home/vscode/.cargo/bin:${containerEnv:PATH}",
    "ANTHROPIC_API_KEY": "${localEnv:ANTHROPIC_API_KEY}",
    "OPENAI_API_KEY": "${localEnv:OPENAI_API_KEY}",
    "GEMINI_API_KEY": "${localEnv:GEMINI_API_KEY}",
    "GOOGLE_API_KEY": "${localEnv:GOOGLE_API_KEY}",
    "MISTRAL_API_KEY": "${localEnv:MISTRAL_API_KEY}"
  },
  // Named volumes: the Go module and build caches are the expensive things to
  // rebuild, and keeping them off the bind-mounted workspace also keeps them
  // off the (slow) host filesystem on macOS and Windows.
  "mounts": [
    "source=pi-go-gomodcache,target=/home/vscode/go/pkg/mod,type=volume",
    "source=pi-go-gobuildcache,target=/home/vscode/.cache/go-build,type=volume"
  ],
  // 6060 = `pi --pprof true` (net/http/pprof). Ollama, if used, runs on the
  // host: point the model base URL at http://host.docker.internal:11434.
  "forwardPorts": [
    6060
  ],
  "portsAttributes": {
    "6060": {
      "label": "pprof",
      "onAutoForward": "silent"
    }
  },
  "onCreateCommand": "bash .devcontainer/post-create.sh",
  // Cheap, and re-runs after a rebuild or a Git worktree switch.
  "postStartCommand": "go mod download",
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",
        "ms-vscode.makefile-tools",
        "github.vscode-github-actions",
        "redhat.vscode-yaml",
        "tamasfe.even-better-toml",
        "eamodio.gitlens",
        "streetsidesoftware.code-spell-checker"
      ],
      "settings": {
        "go.toolsManagement.autoUpdate": false,
        "go.lintTool": "golangci-lint",
        "go.lintFlags": [
          "--path-mode=abs",
          "--fast-only"
        ],
        "go.useLanguageServer": true,
        "gopls": {
          "formatting.local": "github.com/dimetron/pi-go"
        },
        "[go]": {
          "editor.formatOnSave": true,
          "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
          }
        },
        "terminal.integrated.defaultProfile.linux": "zsh"
      }
    }
  },
  "remoteUser": "vscode"
}
