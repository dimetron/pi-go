# kagent Harness + AgentTemplate for pi-go on Agent Substrate.
#
# A template, not a deployable file. Substrate requires a digest-pinned image,
# and a digest is only known once an image has been pushed — so committing a
# rendered manifest means committing a digest that is stale the moment the next
# image is built, and (worse) one that pointed at a local registry nobody else
# can reach.
#
# Render it with render-manifests.sh:
#
#   ./render-manifests.sh --image ghcr.io/dimetron/pi-go-kagent@sha256:... \
#     | kubectl apply -f -
#
# The release workflow renders this on every v* tag and attaches the result to
# the release as kagent-manifests.yaml, pinned to the digest it just pushed.
apiVersion: api.kagent.dev/v1alpha3
kind: Harness
metadata:
  name: ${PI_GO_NAME}
  namespace: ${PI_GO_NAMESPACE}
spec:
  # byo, not kagent: the image is a pi-go process serving kagent's A2A
  # contract (JSON-RPC + gRPC on $PORT, card, /readyz:8081), not an ADK agent
  # driven by kagent's own compiler. `kagent: {}` selects the managed ADK
  # compiler, which expects the ADK runtime's private task-store contract that
  # this image does not implement.
  #
  # The CEL rule on HarnessSpec requires workload.command for a BYO harness.
  byo: {}
  workload:
    image: ${PI_GO_IMAGE}
    command: ["pi", "a2a"]
  substrate:
    workerPoolRef:
      name: ${PI_GO_WORKER_POOL}
    snapshotPolicy:
      location: ${PI_GO_SNAPSHOT_LOCATION}
  # NOTE: no agent-template gating lives here. HarnessSpec has no such field on
  # a v1alpha3 controller (an earlier `allowedAgentTemplates` selector was
  # rejected with "unknown field"), and template->harness binding is expressed
  # on the Agent's spec.harnessRef, which each Agent sets explicitly.
${PI_GO_ENV_BLOCK}---
apiVersion: api.kagent.dev/v1alpha3
kind: AgentTemplate
metadata:
  name: ${PI_GO_NAME}
  namespace: ${PI_GO_NAMESPACE}
  labels:
    runtime: ${PI_GO_NAME}
spec:
  description: pi-go coding agent running on Agent Substrate
  modelConfig:
    name: ${PI_GO_MODEL_CONFIG}
  systemPrompt: |
    You are pi-go, a helpful coding and Kubernetes assistant.
    Use tools carefully and explain actions briefly.
---
# Egress for the MCP servers an AgentTemplate may declare. A BYO runtime gets
# its credentials from the compiler as KAGENT_ENV[...] placeholders inside
# KAGENT_CONFIG_JSON; the value is substituted at the egress gateway and never
# enters the sandbox, so this policy is what actually authorises the call.
#
# The policy is inert on its own: nothing references it until an Agent lists it
# in spec.egressPolicyRefs.
apiVersion: api.kagent.dev/v1alpha3
kind: EgressPolicy
metadata:
  name: ${PI_GO_EGRESS_NAME}
  namespace: ${PI_GO_NAMESPACE}
spec:
  destinations:
  # GitHub MCP, served by the Copilot API. The credential is the one kagent
  # injects as a placeholder, named here by Secret so the gateway can resolve
  # it at request time.
  - origin: https://api.githubcopilot.com
    authentication:
      header: Authorization
      secretKeyRef:
        name: ${PI_GO_GITHUB_SECRET}
        key: Authorization
  # Plain HTTPS origins the GitHub tools follow links to. No credential: these
  # carry no secret and only need to be reachable.
  - origin: https://github.com
  - origin: https://api.github.com
  - origin: https://raw.githubusercontent.com
  - origin: https://codeload.github.com
  - origin: https://objects.githubusercontent.com
