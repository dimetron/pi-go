{
  "name": "pi-go-vscode",
  "displayName": "pi-go",
  "description": "Use pi-go as a native ACP coding agent in VS Code.",
  "version": "0.3.0",
  "publisher": "pi-go",
  "license": "MIT",
  "engines": {
    "vscode": "^1.137.0"
  },
  "categories": ["AI", "Chat"],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCommand:pi-go.start",
    "onChatSession:pi-go",
    "onLanguageModelChatProvider:pi-go"
  ],
  "enabledApiProposals": [
    "chatSessionsProvider",
    "chatParticipantAdditions",
    "chatParticipantPrivate"
  ],
  "contributes": {
    "commands": [
      {
        "command": "pi-go.start",
        "title": "pi-go: Ask (quick prompt)",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "pi-go.refreshSessions",
        "title": "pi-go: Refresh Sessions"
      }
    ],
    "chatParticipants": [
      {
        "id": "pi-go.pi-go-vscode.agent",
        "name": "pi-go",
        "fullName": "pi-go",
        "description": "The pi-go coding agent.",
        "isSticky": true,
        "sampleRequest": "Explain the architecture of this repository."
      }
    ],
    "chatSessions": [
      {
        "type": "pi-go",
        "name": "pi-go",
        "displayName": "pi-go",
        "description": "Sessions powered by the pi-go coding agent over ACP.",
        "when": "true"
      }
    ],
    "languageModelChatProviders": [
      {
        "vendor": "pi-go",
        "displayName": "pi-go"
      }
    ],
    "configuration": {
      "title": "pi-go",
      "properties": {
        "pi-go.command": {
          "type": "string",
          "default": "pi",
          "description": "Path to the pi-go executable."
        },
        "pi-go.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": ["acp-server"],
          "description": "Arguments passed to pi-go."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc --noEmit && node esbuild.js",
    "package": "tsc --noEmit && node esbuild.js --production",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "1.137.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  }
}