# Ship only the built artifacts and static assets.
src/**
esbuild.js
Makefile
tsconfig.json
tsconfig.web.json
*.vsix
.gitignore
node_modules/**
bun.lock
package-lock.json
# Dev-only: the unit suite, its runner config and coverage output, and the
# local smoke harness. None of it is loaded at runtime; VSIX size is install
# size, so none of it ships.
test/**
vitest.config.mts
coverage/**
scripts/**