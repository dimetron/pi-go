#!/usr/bin/env bash
# post-commit: warn loudly when a commit lands without a signature.
#
# commit.gpgsign is true, so this should be unreachable — but op-ssh-sign needs
# the 1Password agent, which is not reachable from inside the sandbox, and
# CLAUDE.md records three commits (0714568, a8b243b, bcb6d26) that landed
# unsigned that way. A full-history scan found 281 unsigned commits; signing
# only became consistent on 2026-07-29.
#
# This runs after the signature would have been applied, so it is the first
# point at which the outcome is actually knowable. It cannot fail the commit —
# post-commit's exit code is ignored — so it prints the repair command instead.
#
# It verifies rather than looking for a gpgsig header. The header survives a
# later rewrite of the commit object, so a header test passes on commits whose
# signature is invalid — see CLAUDE.md, "Verify signatures with git verify-commit".
set -euo pipefail

if [ -n "$(git config --get gpg.ssh.allowedSignersFile || true)" ] \
   && git verify-commit HEAD >/dev/null 2>&1; then
  exit 0
fi

SHA="$(git rev-parse --short HEAD)"
if [ -z "$(git config --get gpg.ssh.allowedSignersFile || true)" ]; then
  REASON="gpg.ssh.allowedSignersFile is not configured, so the signature cannot
  be verified. Set it up once (see CLAUDE.md):

      echo \"$(git config user.email) \$(git config user.signingkey)\" \\
        > ~/.config/git/allowed_signers
      git config --global gpg.ssh.allowedSignersFile ~/.config/git/allowed_signers"
else
  REASON="the signature is missing or INVALID — it fails git verify-commit. A
  gpgsig header is present in a rewritten commit object, which is why a header
  check is not used here. commit.gpgsign is set, so signing most likely failed
  because op-ssh-sign could not reach the 1Password agent from a sandbox."
fi

cat >&2 <<EOF

  ⚠  $SHA DOES NOT HAVE A VALID SIGNATURE

  $REASON

  Re-sign it before pushing:

      git commit --amend --no-edit -S

  Run that with the sandbox disabled. Do not reach for --no-verify: it skips
  the signing path too, which is how the unsigned commits already in this
  history got there.

EOF
